# Copy to .env and fill. Never commit .env. `python -m slabwatch doctor` shows what is missing.

# --- Forecasting ---
FORECAST_BACKEND=               # tabpfn_api | tabpfn_local | gbm | naive (default: tabpfn_api if TABPFN_TOKEN, else gbm)
TABPFN_TOKEN=                   # platform.priorlabs.ai/account/api-keys (also unlocks local 3.5 weights)
TABPFN_NO_BROWSER=1             # headless licence check for the local package

# --- Gemma (reads meter photos and bills; never decides) ---
GEMMA_PROVIDER=google           # google | ollama
GOOGLE_API_KEY=                 # aistudio.google.com/apikey
GEMMA_MODEL=                    # default gemma-3-27b-it (google) / gemma3:4b (ollama); TO VERIFY
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=embeddinggemma      # optional, for tariff-doc vectors

# --- Tiger Cloud (Postgres + timescaledb + pgvector) ---
DATABASE_URL=                   # postgres://tsdbadmin:...@....tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# --- Browserbase (tariff news search + page read; the key alone resolves the project) ---
BROWSERBASE_API_KEY=


# --- Notifications + Temporal ---
NTFY_TOPIC=                     # long random name; ntfy.sh topics are public by name
TEMPORAL_ADDRESS=localhost:7233 # `temporal server start-dev`
TEMPORAL_TASK_QUEUE=slabwatch

# --- The rule (editable: it may have changed; see README) ---
SLAB_THRESHOLD=200
PENALTY_MONTHS=6
CYCLE_DAYS=30
LAT=31.55                       # Lahore
LON=74.34
